+<style id="explorer-review-v231-styles">
+/* Build 231: the fixes and improvements from the review of every page. Each rule group names its item. */
+:root{--stick231:83px}
+/* 1. AV-2's search icon keeps its own size: the OV pages size every svg to their width. */
+.ov1Page132 .search svg{width:14px;height:14px;display:inline-block;flex:none}
+/* 2. Authentication cards: each label on its own line, over its value. */
+.authCardHead>div>small{display:block;margin-bottom:3px;color:var(--muted);font-size:.69rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase}
+.authFacts>span{display:flex;flex-direction:column;gap:2px;min-width:0;font-size:.74rem;line-height:1.35}
+.authFacts>span>small{color:var(--muted);font-size:.69rem;letter-spacing:.05em;text-transform:uppercase}
+/* 3. The RASCI matrix's header sits at the top of its own scroll box. */
+.rasciWrap th{top:0}
+/* 4. SvcV-6: the flow table fits its column; its cells wrap. */
+.svcv6Page172 .model{grid-template-columns:minmax(0,1fr) 300px}
+.svcv6Page172 .tablewrap table{width:100%;table-layout:auto}
+.svcv6Page172 .tablewrap .mx6{min-width:0}
+.svcv6Page172 .tablewrap :is(td,th){white-space:normal;overflow-wrap:anywhere}
+@media(max-width:1180px){.svcv6Page172 .model{grid-template-columns:1fr}}
+/* 5. The Failure Lab's boundary label runs down the gap between two stages, above the arrow. */
+.flowBeam .boundaryLabel{writing-mode:vertical-rl;transform:translateX(-50%) rotate(180deg);top:auto;bottom:9px;left:50%;line-height:1;letter-spacing:.04em}
+/* 6. The Matrix scrolls in a box of its own, one window high under the toolbar, with its header row held at the box's
+   top. The same box scrolls sideways, as the table is wider than the page below about 1,400 px. */
+#matrix.matrixWrap{max-height:calc(100vh - var(--stick231) - 20px);overflow:auto}
+#matrix th{top:0}
+/* 14. The shared section folds away; a line says what's selected. */
+.ctx231{display:flex;align-items:center;justify-content:flex-end;gap:12px;margin:-4px 0 10px}
