+ if(kind==='recovery')return `${num(s.outageMin)}-minute outage at ${num(s.arrivalEps)} EPS, acknowledgement ${s.ackMode}`;
+ return s.profile==='custom'?'Custom data quality':dataQualityPresets[s.profile].name}
+function settingsText({kind,settings:s}){
+ if(kind==='failure'){const f=failureOf(s.failure);return `${f.name} · ${f.scope}${s.scope==='p1'?' · pipeline set 1 only':''}`}
+ if(kind==='correlation')return s.failures.map(id=>`${failureOf(id).name} from ${num(s.timing[id].start)} min for ${num(s.timing[id].duration)}`).join('; ');
+ if(kind==='injection')return `${injectionFaults[s.fault].name} at ${injectionTarget(s)}${s.stage?` (${s.stage})`:''} for ${num(s.durationMin)} min; ${num(s.arrivalEps)} EPS of ${s.eventKb} KB; ${num(s.bufferGb)} GB buffer; ${num(s.recoveryEps)} EPS to recover`;
+ if(kind==='recovery')return `${num(s.outageMin)} min at ${num(s.arrivalEps)} EPS of ${s.eventKb} KB; buffers: source ${num(s.sourceGb)}, UF ${num(s.ufGb)}, HF ${num(s.hfGb)}, Indexer ${num(s.indexerGb)} GB; ${s.pipelineSets} pipeline set${s.pipelineSets===2?'s':''} of ${num(s.perSetEps)} EPS, shared ${num(s.sharedEps)}; replay ${s.replayPct}%; acknowledgement ${s.ackMode}`;
+ const rates=dataQualityIssues.filter(([k])=>s[k]>0).map(([k,label])=>`${label.toLowerCase()} ${s[k]}%`);
+ return `${s.profile==='custom'?'Custom':dataQualityPresets[s.profile].name}: ${num(s.eps)} EPS for ${num(s.windowMin)} min; ${rates.join(', ')||'no defects'}`}
+// ---- Built-in packs. Every scenario is the simulators' own: a failure from the Failure Lab's list, a fault it injects,
+// or inputs to the Recovery and Data-quality simulations. Notes say what each one exercises.
+const RECOVERY_DEFAULT={arrivalEps:12000,eventKb:1.2,outageMin:60,sourceGb:30,ufGb:20,hfGb:10,indexerGb:20,perSetEps:9000,sharedEps:15000,pipelineSets:2,imbalancePct:15,replayPct:5,ackMode:'ambiguous'};
+const DQ_BASE={eps:12000,windowMin:60,eventKb:1.2};
+const dqPreset=id=>({profile:id,...DQ_BASE,...Object.fromEntries(dataQualityIssues.map(([k])=>[k,dataQualityPresets[id][k]]))});
+const F=(failure,name,note,scope='component')=>({kind:'failure',name,note,settings:{failure,scope}});
+const BUILTIN_SOURCE=[
+ {id:'outage-drill',name:'Indexer outage drill',description:'An indexer stops taking data for an hour, then comes back: what the queues and buffers hold, what’s resent, and how long the backlog takes to drain.',scenarios:[
+  F('receiver-down','Receiver unreachable','The forwarder can’t reach its indexer: tcpout_queue fills and backpressure reaches collection.'),
+  {kind:'injection',name:'Indexer down for an hour',note:'The Indexer’s own 20 GB buffer against an hour of 12,000 EPS.',settings:{target:{type:'idx',name:''},stage:'',fault:'unavailable',durationMin:60,arrivalEps:12000,eventKb:1.2,bufferGb:20,recoveryEps:18000}},
+  {kind:'recovery',name:'One-hour outage, acknowledgement in doubt',note:'Events in flight when the link failed are resent, so some may be indexed twice.',settings:{...RECOVERY_DEFAULT}},
+  {kind:'recovery',name:'One-hour outage, acknowledgement confirmed',note:'The same outage with every block confirmed: the replay brings no duplicates.',settings:{...RECOVERY_DEFAULT,ackMode:'confirmed'}},
+  {kind:'recovery',name:'Four-hour outage',note:'The same buffers against four hours: what they can’t hold has to be replayed from the source.',settings:{...RECOVERY_DEFAULT,outageMin:240}},
+  {kind:'correlation',name:'Receiver down, then indexQueue stalls',note:'Two failures eight minutes apart: which one is the cause, and which follows from it.',settings:{failures:['receiver-down','index-stall'],timing:{'receiver-down':{start:0,duration:30},'index-stall':{start:8,duration:45}}}}]},
+ {id:'parsing-quality',name:'Parsing and event quality',description:'Defects that arrive intact but search badly: line breaking, truncation, timestamps and schema drift.',scenarios:[
+  F('line-breaker','Incorrect LINE_BREAKER','Events split or merged in the wrong places, before any other parsing.'),
+  F('truncate','TRUNCATE too low','Long events cut at the limit, losing the fields at their end.'),
+  F('timestamp','Timestamp extraction failure','Events indexed at the wrong time, so searches over a time range miss them.'),
+  {kind:'data-quality',name:'Truncation and boundaries',note:'The simulation’s truncation preset, at 12,000 EPS for an hour.',settings:dqPreset('truncation')},
+  {kind:'data-quality',name:'Timestamp corruption',note:'The simulation’s timestamp preset: parse failures and events out of their time window.',settings:dqPreset('timestamp')},
+  {kind:'data-quality',name:'Schema drift',note:'The simulation’s schema-drift preset: required fields missing as the source changes.',settings:dqPreset('schema')}]},
+ {id:'hec-ingestion',name:'HEC ingestion',description:'The HTTP Event Collector refusing requests, unavailable, or unable to confirm what it took.',scenarios:[
+  F('hec-reject','HEC request rejected','Requests refused at admission: the client must hold and resend them.'),
+  F('hec-unavailable','HEC endpoint unavailable','The endpoint is down: what the clients don’t buffer is lost.'),
+  F('hec-ack-timeout','HEC acknowledgement not confirmed','Events taken but not confirmed: clients that resend can duplicate them.'),
+  {kind:'injection',name:'Tokens rejected for 30 minutes',note:'Needs a HEC endpoint in the topology. Its clients buffer 5 GB.',settings:{target:{type:'hecEndpoint',name:''},stage:'',fault:'authentication',durationMin:30,arrivalEps:12000,eventKb:1.2,bufferGb:5,recoveryEps:18000}},
+  {kind:'recovery',name:'Clients resend a fifth of an hour’s events',note:'Acknowledgement off: the model counts about a third of the replay as duplicates.',settings:{...RECOVERY_DEFAULT,replayPct:20,ackMode:'disabled'}}]},
+ {id:'ds-incidents',name:'Deployment Server incidents',description:'Fleet management failing while events may still flow: an unreachable server, a phone-home storm, a change that reaches too many agents.',scenarios:[
+  F('deployment-server-unreachable','Deployment Server unreachable','Agents keep their last configuration; nothing new reaches them.'),
+  F('deployment-phonehome-storm','Phone-home storm after an outage','Every agent phones home at once when the server comes back.'),
+  F('deployment-blast-radius','Server-class change reaches too many agents','A class change matches far more of the fleet than meant.'),
+  F('management-healthy-event-broken','Management healthy, events broken','The agent phones home, but its events don’t arrive: the two planes fail apart.'),
+  {kind:'correlation',name:'Server back after an hour, then the storm',note:'The outage, then the agents that all phone home when it ends.',settings:{failures:['deployment-server-unreachable','deployment-phonehome-storm'],timing:{'deployment-server-unreachable':{start:0,duration:60},'deployment-phonehome-storm':{start:60,duration:20}}}}]},
+ {id:'identity',name:'Identity and credentials',description:'Sign-in and machine trust failing: the identity provider, MFA, certificates, tokens, and a rotation done halfway.',scenarios:[
