+const failureOf=id=>failures.find(f=>f.id===id);
+const typeName=t=>builderComponents[t]?.name||t;
+
+// ---- The five kinds of scenario, and the simulator each opens in.
+const KINDS={
+ failure:{label:'Failure',family:'failure',page:'failure',where:'Failure Lab · Single'},
+ correlation:{label:'Correlated failures',family:'failure',page:'failure',where:'Failure Lab · Correlate'},
+ injection:{label:'Injected fault',family:'failure',page:'failure',where:'Failure Lab · Inject'},
+ recovery:{label:'Recovery',family:'recovery',page:'recovery',where:'Operate › Recovery simulation'},
+ 'data-quality':{label:'Data quality',family:'data-quality',page:'data-quality',where:'Operate › Data-quality simulation'}};
+const FAMILIES={failure:'Failure Lab',recovery:'Recovery','data-quality':'Data quality'};
+const RECOVERY_KEYS=['arrivalEps','eventKb','outageMin','sourceGb','ufGb','hfGb','indexerGb','perSetEps','sharedEps','pipelineSets','imbalancePct','replayPct','ackMode'];
+const DQ_KEYS=['profile','eps','windowMin','eventKb',...dataQualityIssues.map(([k])=>k)];
+const FAULT_KEYS=['durationMin','arrivalEps','eventKb','bufferGb','recoveryEps'];
+
+// The simulators read the page's state. A scenario runs on a copy of the parts it sets; the page's own are put back.
+function withState(patch,fn){
+ const keys=Object.keys(patch),saved=keys.map(k=>[k,state[k]]);
+ try{for(const k of keys)state[k]=clone(patch[k]);return fn()}
+ finally{for(const [k,v] of saved)state[k]=v}}
+
+// A scenario's settings, checked and set within the simulators' own limits: {ok, scenario} or {ok:false, why}.
+const finite=(v,min,max=Infinity)=>Number.isFinite(Number(v))?Math.min(max,Math.max(min,Number(v))):null;
+function normalize(raw){
+ const kind=raw?.kind,s=raw?.settings||{},name=String(raw?.name||'').trim().slice(0,120),note=String(raw?.note||'').trim().slice(0,400);
+ if(!KINDS[kind])return {ok:false,why:`“${String(kind)}” isn’t a kind of scenario this build knows`};
+ let settings;
+ if(kind==='failure'){
+  const f=failureOf(s.failure);if(!f)return {ok:false,why:`“${String(s.failure)}” isn’t a failure in this build`};
+  settings={failure:f.id,scope:s.scope==='p1'&&laneLocalFailures.has(f.id)?'p1':'component'}}
+ else if(kind==='correlation'){
+  const ids=[...new Set((Array.isArray(s.failures)?s.failures:[]).map(String))],unknown=ids.filter(id=>!failureOf(id));
+  if(unknown.length)return {ok:false,why:`${unknown.map(x=>`“${x}”`).join(', ')} ${unknown.length===1?'isn’t a failure':'aren’t failures'} in this build`};
+  if(ids.length<2||ids.length>4)return {ok:false,why:`a correlation takes 2 to 4 failures, not ${ids.length}`};
+  settings={failures:ids,timing:Object.fromEntries(ids.map(id=>{const t=s.timing?.[id]||{};return [id,{start:finite(t.start,0,10080)??0,duration:finite(t.duration,1,10080)??30}]}))}}
+ else if(kind==='injection'){
+  const t=s.target||{};if(!builderComponents[t.type])return {ok:false,why:`“${String(t.type)}” isn’t a Builder component in this build`};
+  if(!injectionFaults[s.fault])return {ok:false,why:`“${String(s.fault)}” isn’t a fault this build injects`};
+  settings={target:{type:t.type,name:String(t.name||'').slice(0,120)},stage:String(s.stage||''),fault:s.fault,
+   durationMin:finite(s.durationMin,1,10080)??30,arrivalEps:finite(s.arrivalEps,0)??0,eventKb:finite(s.eventKb,.01)??1.2,bufferGb:finite(s.bufferGb,0)??0,recoveryEps:finite(s.recoveryEps,0)??0}}
+ else if(kind==='recovery'){
+  // recoveryModel() sets its own limits: its inputs, as it reads them, are the settings.
+  const base=clone(state.recovery);for(const k of RECOVERY_KEYS)if(s[k]!==undefined)base[k]=s[k];
+  const c=withState({recovery:base},()=>recoveryModel().c);settings=Object.fromEntries(RECOVERY_KEYS.map(k=>[k,c[k]]))}
+ else{
+  const base=clone(state.dataQuality);for(const k of DQ_KEYS)if(s[k]!==undefined)base[k]=s[k];
+  const c=withState({dataQuality:base},()=>dataQualityModel().c);settings=Object.fromEntries(DQ_KEYS.map(k=>[k,c[k]]));
+  if(!dataQualityPresets[settings.profile])settings.profile='custom';
+  else if(dataQualityIssues.some(([k])=>Number(dataQualityPresets[settings.profile][k])!==settings[k]))settings.profile='custom'}
