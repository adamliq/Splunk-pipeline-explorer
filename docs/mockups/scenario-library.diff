+// ---- Names and one-line settings, as a person reads them.
+function injectionTarget(s){return s.target?(s.target.name||typeName(s.target.type)):'a component'}
+function autoName({kind,settings:s}){
+ if(kind==='failure')return failureOf(s.failure).name+(s.scope==='p1'?' (pipeline set 1)':'');
+ if(kind==='correlation')return s.failures.map(id=>failureOf(id).name).join(' + ');
