+ else if(sc.kind==='correlation')Object.assign(state,{failureCorrelation:true,failureInjectionMode:false,correlatedFailures:s.failures,failureTiming:{...state.failureTiming,...s.timing},highlightFailure:false});
+ else if(sc.kind==='injection')Object.assign(state,{failureCorrelation:false,failureInjectionMode:true,failureInjection:{...s,target:resolveTarget(s.target).id},highlightFailure:false});
+ else if(sc.kind==='recovery')state.recovery={...s};
+ else state.dataQuality={...s};
+ LIB.opened={page,name:sc.name,pack:p.name,before};
+ say(`Opened “${sc.name}” in ${KINDS[sc.kind].where}, in place of its settings.`);LIB.msg.putBack=true;
+ showPage(page)}
+function putBack(){
+ const o=LIB.opened;if(!o)return;for(const [k,v] of Object.entries(o.before))state[k]=clone(v);LIB.opened=null;
+ if(LIB.msg)LIB.msg.putBack=false;
+ if(state.view==='operations'&&state.operationsView==='scenario-library'){say(`Put back the settings “${o.name}” had replaced.`);rerender('.sl235Msg');return}
+ showPage(o.page)}
+// A note at the top of the page a scenario was opened in.
+function bannerFor(page){
+ const o=LIB.opened;if(!o||o.page!==page)return null;const b=document.createElement('div');b.className='sl235Banner';b.setAttribute('role','status');b.tabIndex=-1;
+ b.innerHTML=`<span>From the scenario library: <strong>${esc(o.name)}</strong> (${esc(o.pack)}).</span><button type="button" data-sl235-banner-back>Put back the previous settings</button><button type="button" data-sl235-banner-lib>Back to the library</button>`;
+ b.querySelector('[data-sl235-banner-back]').onclick=()=>putBack();
+ b.querySelector('[data-sl235-banner-lib]').onclick=()=>{state.operationsView='scenario-library';switchView('operations')};
+ return b}
+
+// ---- Save to library: the Failure Lab (each of its modes), the Recovery and the Data-quality simulations.
+function capture(from){
+ if(from==='recovery')return {kind:'recovery',settings:recoveryModel().c};
+ if(from==='data-quality')return {kind:'data-quality',settings:dataQualityModel().c};
+ if(state.failureInjectionMode){const m=failureInjectionModel(),t=m.target;
+  return {kind:'injection',settings:{target:t?{type:t.type,name:componentInstanceLabel(t)}:null,stage:m.stage,fault:m.c.fault,durationMin:m.duration,arrivalEps:m.arrival,eventKb:m.eventKb,bufferGb:m.buffer,recoveryEps:m.normalCapacity}}}
+ if(state.failureCorrelation)return {kind:'correlation',settings:{failures:state.correlatedFailures,timing:state.failureTiming}};
+ return {kind:'failure',settings:{failure:state.failure,scope:state.failureScope}}}
+function saveCurrent(from){
+ const r=normalize({...clone(capture(from)),id:undefined});if(!r.ok)return {ok:false,why:r.why};
+ const p=targetPack();p.scenarios.push(r.scenario);const stored=save();return {ok:true,scenario:r.scenario,pack:p,stored}}
+function saveBox(from){
+ const box=document.createElement('div');box.className='sl235SaveBox';
+ box.innerHTML=`<button type="button" class="builderBtn" data-sl235-save="${from}">Save to library</button><span class="sl235SaveMsg" role="status"></span>`;
+ box.querySelector('button').onclick=()=>{const r=saveCurrent(from),msg=box.querySelector('.sl235SaveMsg');
+  if(!r.ok){msg.textContent=`Not saved: ${r.why}.`;msg.dataset.kind='error';return}
+  msg.dataset.kind='ok';msg.textContent='';msg.append(`Saved “${r.scenario.name}” to ${r.pack.name}${r.stored?'':' for this visit (the browser keeps nothing)'}. `);
+  const go=document.createElement('button');go.type='button';go.className='sl235Link';go.textContent='Open the library';go.onclick=()=>{LIB.pack=r.pack.id;state.operationsView='scenario-library';switchView('operations')};msg.append(go)};
+ return box}
+// The Failure Lab draws its list and detail from a function for each mode, and its fields redraw them; Operate redraws its
+// content for each page. Whenever any of them is drawn again, the save box and the banner go back in.
+function placeBanner(root,page){
+ const o=LIB.opened,key=o&&o.page===page?`${o.pack} › ${o.name}`:'',has=root.querySelector(':scope > .sl235Banner');
+ if(has&&has.dataset.sl235For===key)return;has?.remove();if(key){const b=bannerFor(page);b.dataset.sl235For=key;root.prepend(b)}}
+function decorateLab(){
+ const list=$('#scenarioList'),mode=list?.querySelector('.failureMode');
+ if(mode&&!list.querySelector('.sl235SaveBox')){const box=saveBox('failure');box.classList.add('inLab');(list.querySelector('.correlationHint')||mode).after(box)}
+ const detail=$('#failureDetail');if(detail)placeBanner(detail,'failure')}
+function decorateOps(){
+ const page=state.operationsView,root=$('#operationsContent');if(!root||(page!=='recovery'&&page!=='data-quality'))return;
+ const ctl=root.querySelector('.opsHero .opsControls');if(ctl&&!ctl.querySelector('[data-sl235-save]'))ctl.prepend(saveBox(page));
+ placeBanner(root,page)}
+const decorate=()=>{try{decorateLab();decorateOps()}catch(e){console.error(e)}};
+for(const id of ['scenarioList','failureDetail','operationsContent']){const el=document.getElementById(id);if(el)new MutationObserver(decorate).observe(el,{childList:true})}
+decorate();
+
+// ---- Operate's menu: Scenario library after Data-quality simulation.
+const opsDq=document.querySelector('.operationsNav [data-operations-view="data-quality"]');
+if(opsDq){const b=document.createElement('button');b.type='button';b.dataset.operationsView='scenario-library';b.textContent='Scenario library';b.className=opsDq.className.replace(/\bactive\b/,'').trim();
+ b.onclick=()=>{state.operationsView='scenario-library';renderOperations()};opsDq.after(b)}
+const renderOperationsBefore235=renderOperations;
+renderOperations=function(...args){
+ if(state.operationsView!=='scenario-library')return renderOperationsBefore235.apply(this,args);
+ $$('.operationsNav button').forEach(b=>b.classList.toggle('active',b.dataset.operationsView===state.operationsView));renderScenarioLibrary()};
+// For the checks: the models and the library's own state.
+window.scenarios235={KINDS,BUILTIN,LIB,normalize,autoName,settingsText,outcome,runPack,resultsCsv,packFileText,readPackFile,openScenario,putBack,saveCurrent,capture,
+ userPacks,allPacks,newPack,targetPack,withState,resolveTarget,renderScenarioLibrary,STORE,PACK_SCHEMA,store:()=>store};
+})();
+</script>
