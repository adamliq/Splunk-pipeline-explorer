+
+// The view: its own section between the files and the view's Matrix.
+const root=document.createElement('section');root.id='configTypeMap217';root.className='tmMap217';root.setAttribute('aria-label','Source type map');root.hidden=true;
+(document.getElementById('configView205')||document.getElementById('matrix'))?.after(root);
